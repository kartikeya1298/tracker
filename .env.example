# --- Database & cache (docker-compose overrides these to point at the postgres/redis services) ---
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/career_tracker
REDIS_URL=redis://localhost:6379/0

# --- Scheduler ---
SCRAPE_INTERVAL_MINUTES=15
SCRAPER_CONCURRENCY=5
SCRAPER_REQUEST_TIMEOUT_SECONDS=30

# --- Filters ---
INCLUDE_REMOTE=true
INCLUDE_GLOBAL=false
INCLUDE_INTERNSHIPS=false
TARGET_LOCATIONS=["india"]
MAX_EXPERIENCE_YEARS=2.0

# --- AI (Anthropic Claude) — leave ANTHROPIC_API_KEY blank to disable AI enrichment ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_FEATURES_ENABLED=true
RESUME_TEXT_PATH=./data/resume.txt

# --- Email notifications (SMTP) — leave SMTP_HOST blank to disable notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFICATION_FROM_EMAIL=career-tracker@example.com
NOTIFICATION_TO_EMAILS=["you@example.com"]

# --- App ---
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3000"]
PLAYWRIGHT_HEADLESS=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
